{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "incremental": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "@library/contexts": ["./src/exports/library/contexts"],
      "@library/hooks": ["./src/exports/library/hooks"],
      "@library/providers": ["./src/exports/library/providers"],
      "@ui/components/layout": ["./src/exports/ui/components/layout"],
      "@ui/components/page": ["./src/exports/ui/components/page"],
      "@ui/components/shared": ["./src/exports/ui/components/shared"],
      "@ui/styles/layout": ["./src/exports/ui/styles/layout"],
      "@ui/styles/page": ["./src/exports/ui/styles/page"],
      "@ui/styles/shared": ["./src/exports/ui/styles/shared"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2017"
  },
  "exclude": ["node_modules"],
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ]
}
